#!/bin/sh
# AppImage entrypoint for MangaJaNai GUI.
#
# The AppImage mounts read-only. Settings, the user's models and the TensorRT engines live where an
# installed copy keeps them ($XDG_CONFIG_HOME/MangaJaNaiConverterGui, MANGAJANAI_STATE_DIR). The
# TensorRT runtime, this GPU's builder pack and the default models live in the shared pack store,
# installed on first launch (below). The updater is not shipped in the AppImage: a new version is a
# new AppImage.
set -eu

HERE="$(dirname "$(readlink -f "$0")")"

# Desktop integration:
#   <AppImage> --install     register a menu entry
#   <AppImage> --uninstall   remove it
case "${1:-}" in
  --install|--uninstall)
    APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    ICONS="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
    desktop="$APPS/mangajanai-gui.desktop"
    if [ "$1" = "--uninstall" ]; then
        rm -f "$desktop" "$ICONS/mangajanai-gui.png"
        update-desktop-database "$APPS" 2>/dev/null || true
        echo "Removed the MangaJaNai GUI menu entry."
        echo "(settings, models and engines in ${XDG_CONFIG_HOME:-$HOME/.config}/MangaJaNaiConverterGui and the"
        echo " the TensorRT runtime and models in the shared pack store are kept while this AppImage exists)"
        exit 0
    fi
    target="${APPIMAGE:-$HERE/AppRun}"
    [ -z "${APPIMAGE:-}" ] && echo "warning: \$APPIMAGE unset (run the .AppImage directly, not extracted); using $target" >&2
    mkdir -p "$APPS" "$ICONS"
    [ -f "$HERE/mangajanai-gui.png" ] && cp -f "$HERE/mangajanai-gui.png" "$ICONS/mangajanai-gui.png"
    cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=MangaJaNai GUI
Comment=Upscale manga and images with ONNX models on NVIDIA TensorRT
Exec="$target"
TryExec=$target
Icon=mangajanai-gui
Terminal=false
Categories=Graphics;
StartupNotify=true
EOF
    update-desktop-database "$APPS" 2>/dev/null || true
    echo "Installed: 'MangaJaNai GUI' now appears in your app menu."
    echo "  entry:    $desktop"
    echo "  launches: $target"
    exit 0
    ;;
esac

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/MangaJaNaiGUI"
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/MangaJaNaiConverterGui"
mkdir -p "$DATA" "$STATE"

# TensorRT, this GPU's builder pack and the default models come from the shared pack store
# (~/.local/share/the-database/aji, shared with other apps: aji-runtime), installed by the aji-runtime
# in the image from the runtime release manifest.json pins. One install per version and pack set, in
# the background so the window appears right away (the app shows the runtime as missing until it's
# done); progress goes to $DATA/fetch.log. libaji and the app find the packs through
# $DATA/aji-runtime.json, which AJI_RUNTIME_JSON points them at (the image is read-only). The store
# keeps them while this AppImage file exists (its ref is the AppImage's path); a new version's
# AppImage installs its own set, and packs no AppImage or app uses any more are freed. aji-runtime is
# copied out of the image first: the mount goes away when the app exits, and the install may outlive
# it. A failure is non-fatal (offline): it runs again on the next launch.
ver="$(cat "$HERE/version.txt" 2>/dev/null || echo "")"
manifest="$HERE/manifest.json"
url="$(sed -n 's/.*"index_url": *"\([^"]*\)".*/\1/p' "$manifest" 2>/dev/null | head -1)"
sha="$(sed -n 's/.*"index_sha256": *"\([0-9a-f]*\)".*/\1/p' "$manifest" 2>/dev/null | head -1)"
export AJI_RUNTIME_JSON="$DATA/aji-runtime.json"
# The NVIDIA GPUs' compute capabilities (86 for 8.6). TensorRT needs 7.5+ (RTX 20 / GTX 16 series and
# newer; the app's GpuSupport.TrtMinComputeCapability): older GPUs are left out, and with only those
# there's no TensorRT (Linux has no DirectML), so only the models. The newest GPU picks the DAT2/HAT
# variant: bf16 on 8.0+, else fp32.
TRT_MIN_CC=75
ccs="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | tr -d ' .' | sort -un)"
trt_sms=""
for c in $ccs; do
    [ "$c" -ge "$TRT_MIN_CC" ] 2>/dev/null && trt_sms="${trt_sms:+$trt_sms,}sm$c"
done
cc="$(echo "$ccs" | tail -1)"
variant=fp32
[ "${cc:-0}" -ge 80 ] 2>/dev/null && variant=bf16
want="models-mangajanai,models-illustrationjanai,models-illustrationjanai-$variant"
# trt: the TensorRT runtime and a builder pack per GPU generation in trt_sms (passed as --gpus, so an
# old GPU next to a new one gets no builder pack). Linux has no TensorRT-RTX.
[ -n "$trt_sms" ] && want="trt,$want"
stamp="$DATA/aji-runtime.stamp"
target="${APPIMAGE:-$HERE/AppRun}"
need=0
if [ ! -f "$AJI_RUNTIME_JSON" ] || [ "$(cat "$stamp" 2>/dev/null)" != "$ver $want" ]; then
    need=1
fi
# One install at a time; the lock holds the installing shell's pid, so a lock left by an install
# that was killed is noticed and cleared on the next launch.
lock="$DATA/.fetch.lock"
if [ -f "$lock" ] && ! kill -0 "$(cat "$lock" 2>/dev/null)" 2>/dev/null; then
    rm -f "$lock"
fi
if [ $need = 1 ] && [ -x "$HERE/aji-runtime" ] && [ -n "$url" ] && [ -n "$sha" ] && [ ! -f "$lock" ]; then
    cp -f "$HERE/aji-runtime" "$DATA/aji-runtime" 2>/dev/null || true
    export DATA ver url sha want stamp target lock trt_sms
    # setsid: its own session, so closing the app (or Ctrl+C in its terminal) doesn't stop it
    installer='
        echo $$ > "$lock"
        trap '\''rm -f "$lock"'\'' EXIT
        echo "MangaJaNai GUI: installing $want into the shared pack store (one-time)..."
        if "$DATA/aji-runtime" ensure --app-id mangajanai-gui-appimage --app-path "$target" \
               --app-version "$ver" --index "$url" --index-sha256 "$sha" --want "$want" \
               --gpus "${trt_sms:-none}" --aji-dir "$DATA"; then
            echo "$ver $want" > "$stamp"
            # builder kernels an AppImage from before the store fetched here
            rm -f "$DATA"/inference/libnvinfer_builder_resource_* "$DATA/7zz"
            rmdir "$DATA/inference" 2>/dev/null || true
        else
            echo "MangaJaNai GUI: the pack store install failed; it runs again on the next launch."
        fi
        true'
    if command -v setsid >/dev/null 2>&1; then
        setsid sh -c "$installer" >"$DATA/fetch.log" 2>&1 < /dev/null &
    else
        nohup sh -c "$installer" >"$DATA/fetch.log" 2>&1 < /dev/null &
    fi
fi

export MANGAJANAI_STATE_DIR="$STATE"
cd "$STATE"
exec "$HERE/MangaJaNaiConverterGui" "$@"
